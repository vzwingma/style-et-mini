# ============================================================
# Style & Mini — Variables d'environnement
# ============================================================
# Copier ce fichier en .env.local, .env.qua ou .env.prod
# selon l'environnement cible et renseigner les valeurs.
#
# Tous les fichiers .env.* (sauf .env.template) sont ignorés
# par git — NE PAS COMMITER les valeurs réelles.
# ============================================================

# URL de base de l'API backend (avec slash final)
EXPO_PUBLIC_BACKEND_URL=https://<api-gateway-id>.execute-api.eu-west-3.amazonaws.com/<stage>/

# Identifiant Basic Auth pour le backend
EXPO_PUBLIC_BACKEND_AUTH=<auth_user>

# Mot de passe Basic Auth pour le backend
EXPO_PUBLIC_BACKEND_PWD=<auth_password>

# URL de base du CDN S3/CloudFront pour les images (avec slash final)
EXPO_PUBLIC_S3_URL=https://<cloudfront-id>.cloudfront.net/
